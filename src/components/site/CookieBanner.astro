---
import {GA4_ID} from '../../data/site';

// The cookie banner. ConsentScripts.astro decides who sees it and handles the buttons; it starts hidden, so visitors
// outside Europe never see it. Accept and Reject look the same, as EU regulators expect.

const button =
  'flex-1 px-4 py-2.5 bg-white hover:bg-slate-50 text-slate-800 border border-slate-300 rounded-xl text-sm font-semibold transition-colors';
---

{
  GA4_ID && (
    <div
      id="cookie-banner"
      role="region"
      aria-label="Cookie consent"
      hidden
      class="fixed z-50 bottom-4 inset-x-4 sm:left-auto sm:right-6 sm:bottom-6 sm:max-w-sm bg-white border border-slate-200 rounded-2xl p-5 shadow-2xl"
    >
      <p class="text-sm text-slate-700 leading-relaxed">
        We use cookies to measure site traffic and ad performance.{' '}
        <a href="/privacy/" class="text-teal-700 underline">Privacy policy</a>
      </p>
      <div class="mt-4 flex gap-3">
        <button type="button" data-consent="granted" class={button}>Accept</button>
        <button type="button" data-consent="denied" class={button}>Reject</button>
      </div>
    </div>
  )
}
