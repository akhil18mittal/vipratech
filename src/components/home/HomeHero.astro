---
import {ContactButtons} from '../site/ContactButtons';
import {QUEUE_ROWS, TICKER_ITEMS} from '../../data/home';
import type {ContactLinks} from '../../types';

// The homepage hero in the site's signal-grid style: a fading grid, a glow, floating particles, a headline that types
// itself in (src/scripts/home.ts), proof figures, and the review queue on the right. Below it, the lime ticker.
// Everything here is plain HTML first: with JavaScript off, the headline and four queue rows are already in place.

interface Props {
  contact: ContactLinks;
  metrics: readonly {value: string; label: string}[];
}

const {contact, metrics} = Astro.props;
const tone = {held: 'text-amber-300', dispute: 'text-sky-300', ok: 'text-lime-400'} as const;
const particles = Array.from({length: 12}, (_, i) => ({
  left: `${(i * 37 + 7) % 100}%`,
  top: `${20 + ((i * 53) % 70)}%`,
  duration: `${12 + ((i * 7) % 10)}s`,
  delay: `${-((i * 3) % 12)}s`,
  size: i % 3 === 0 ? 'w-2 h-2' : 'w-1.5 h-1.5',
}));
const tickerItems = [...TICKER_ITEMS, ...TICKER_ITEMS];
---

<section class="relative pt-12 sm:pt-16 pb-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
  <div aria-hidden="true" class="vt-grid absolute inset-x-0 -top-16 h-[36rem] -z-10 pointer-events-none"></div>
  <div aria-hidden="true" class="vt-glow absolute left-0 top-10 w-[44rem] h-96 -z-10 pointer-events-none"></div>
  <div aria-hidden="true" class="absolute inset-0 -z-10 overflow-hidden pointer-events-none">
    {
      particles.map((p) => (
        <span
          class={`vt-particle absolute ${p.size} rounded-full bg-lime-400/50 blur-[1px]`}
          style={`left: ${p.left}; top: ${p.top}; animation-duration: ${p.duration}; animation-delay: ${p.delay}`}
        />
      ))
    }
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
    <div class="lg:col-span-7 space-y-6">
      <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-lime-400/10 border border-lime-400/40 text-lime-400 text-xs font-mono">
        <span class="relative flex w-2.5 h-2.5" aria-hidden="true">
          <span class="absolute inline-flex w-full h-full rounded-full bg-lime-400 opacity-75 animate-ping"></span>
          <span class="relative inline-flex w-2.5 h-2.5 rounded-full bg-lime-400"></span>
        </span>
        <span>CLAIMS ENGINE · IN PRODUCTION SINCE MID-2026</span>
      </span>

      <h1 class="text-4xl sm:text-5xl xl:text-[3.4rem] font-black tracking-tight leading-[1.08]" data-typed-headline>
        <span class="text-white" data-typed-line>Stop paying claims and</span>
        <br />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-lime-400 via-emerald-300 to-teal-300" data-typed-line>
          deductions you don't owe.
        </span>
      </h1>

      <p class="text-base sm:text-lg text-zinc-300 leading-relaxed max-w-2xl">
        VipraTech checks every distributor claim, retailer and platform deduction, subsidy and freight claim against your
        schemes, invoices, receipts and contracts, flags what does not hold up, and gives finance a clean settlement
        sheet to approve.
      </p>

      <div class="grid grid-cols-3 gap-3 max-w-xl">
        {
          metrics.map((metric) => (
            <div class="p-3.5 bg-zinc-900/90 border border-zinc-800 rounded-xl hover:border-lime-500/50 hover:-translate-y-0.5 transition-all shadow-md">
              <span class="block text-xl sm:text-2xl font-black font-mono text-lime-400">{metric.value}</span>
              <span class="text-[11px] text-zinc-400 uppercase font-mono mt-0.5 block leading-snug">{metric.label}</span>
            </div>
          ))
        }
      </div>

      <div class="space-y-4 pt-1">
        <ContactButtons links={contact} location="hero" />
        <a href="/sample-audit-report/" class="inline-block text-sm font-semibold text-lime-400 hover:text-lime-300 hover:underline underline-offset-2">
          See a sample audit report →
        </a>
      </div>
    </div>

    <div class="lg:col-span-5">
      <div class="relative p-5 sm:p-6 bg-zinc-900/95 border border-zinc-800 rounded-2xl shadow-2xl shadow-lime-400/5 overflow-hidden space-y-4 backdrop-blur-md">
        <div aria-hidden="true" class="vt-sweep absolute inset-x-0 h-0.5 bg-gradient-to-r from-transparent via-lime-400 to-transparent opacity-70 pointer-events-none z-20"></div>
        <div class="flex items-center justify-between pb-3 border-b border-zinc-800">
          <span class="text-xs font-mono text-zinc-200 font-bold tracking-wide">VIPRATECH_REVIEW_QUEUE.LOG</span>
          <span class="flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-lime-400 animate-ping" aria-hidden="true"></span>
            <span class="text-[10px] font-mono text-lime-400 font-bold">LIVE</span>
          </span>
        </div>
        <ul class="space-y-2 font-mono" data-queue aria-label="Sample review queue">
          {
            QUEUE_ROWS.slice(0, 4).map((row) => (
              <li class="p-3 bg-zinc-950/90 border border-zinc-800/80 rounded-xl flex items-center justify-between gap-3">
                <span class="min-w-0">
                  <span class="text-[10px] text-zinc-500 font-bold block">[{row.type}]</span>
                  <span class="text-xs text-white font-medium block truncate">{row.text}</span>
                </span>
                <span class="text-right flex-shrink-0">
                  <span class={`text-[10px] font-bold block ${tone[row.tone]}`}>{row.status}</span>
                  <span class="text-[9px] text-zinc-500 block">{row.confidence}</span>
                </span>
              </li>
            ))
          }
        </ul>
        <div class="pt-2 flex items-center justify-between gap-3 text-[11px] font-mono border-t border-zinc-800">
          <span class="text-zinc-400">Rules + AI + finance approval</span>
          <span class="text-zinc-500">SAMPLE DATA</span>
        </div>
      </div>
    </div>
  </div>
</section>

<div class="relative z-10 w-full bg-lime-400 text-black py-2.5 overflow-hidden whitespace-nowrap font-mono text-xs font-bold tracking-widest uppercase border-y border-lime-500/50 shadow-lg shadow-lime-400/10">
  <div class="vt-ticker-track inline-flex items-center gap-10 pr-10" aria-hidden="true">
    {
      tickerItems.map((item) => (
        <span class="flex items-center gap-10">
          <span>{item}</span>
          <span>•</span>
        </span>
      ))
    }
  </div>
  <p class="sr-only">{TICKER_ITEMS.join('. ')}</p>
</div>
