---
import {CALCULATOR_DEFAULTS} from '../../data/home';

// "What is leaking?" The visitor enters their own monthly claim value, the share they think is invalid, their line
// count and the minutes each line takes; the results update as they type (src/scripts/home.ts). Every number is
// theirs: nothing here claims a recovery rate. With JavaScript off, the results for the starting values are shown.

const d = CALCULATOR_DEFAULTS;
const inr = (value: number) => `₹${Math.round(value).toLocaleString('en-IN')}`;
const atRiskYear = d.monthlyLakh * 100000 * (d.invalidPct / 100) * 12;
const hoursMonth = (d.lines * d.minutesPerLine) / 60;
const fields = [
  {id: 'calc-monthly', name: 'monthlyLakh', label: 'Claims and deductions settled per month', unit: '₹ lakh', value: d.monthlyLakh, min: 1, max: 5000, step: 1},
  {id: 'calc-pct', name: 'invalidPct', label: 'Share you think is invalid or overpaid', unit: '%', value: d.invalidPct, min: 0.1, max: 20, step: 0.1},
  {id: 'calc-lines', name: 'lines', label: 'Claim lines checked per month', unit: 'lines', value: d.lines, min: 100, max: 1000000, step: 100},
  {id: 'calc-minutes', name: 'minutesPerLine', label: 'Minutes your team spends per line', unit: 'min', value: d.minutesPerLine, min: 0.5, max: 30, step: 0.5},
];
const result = 'block text-3xl sm:text-4xl font-black font-mono text-lime-400 break-all';
---

<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start" data-calculator>
  <form class="lg:col-span-6 bg-zinc-900/80 border border-zinc-800 rounded-2xl p-6 sm:p-8 space-y-5 shadow-xl backdrop-blur-md" onsubmit="return false">
    {
      fields.map((field) => (
        <label for={field.id} class="block space-y-2">
          <span class="flex items-baseline justify-between gap-4">
            <span class="text-sm font-semibold text-white">{field.label}</span>
            <span class="text-xs font-mono text-zinc-500">{field.unit}</span>
          </span>
          <input
            id={field.id}
            name={field.name}
            type="number"
            inputmode="decimal"
            value={field.value}
            min={field.min}
            max={field.max}
            step={field.step}
            class="w-full px-4 py-3 bg-zinc-950 border border-zinc-700 rounded-xl text-white font-mono text-base focus:outline-none focus:border-lime-400"
          />
        </label>
      ))
    }
  </form>

  <div class="lg:col-span-6 relative bg-gradient-to-br from-zinc-900 via-zinc-950 to-zinc-900 border border-lime-500/40 rounded-2xl p-6 sm:p-8 space-y-6 shadow-2xl overflow-hidden" aria-live="polite">
    <div aria-hidden="true" class="vt-glow absolute -right-20 -top-20 w-80 h-80 pointer-events-none"></div>
    <div class="relative space-y-1">
      <span class="text-xs font-mono text-zinc-400 uppercase tracking-wider">Money at risk each year</span>
      <span class={result} data-out="atRisk">{inr(atRiskYear)}</span>
      <span class="block text-sm text-zinc-400">Claims settled per year × the share you think is invalid.</span>
    </div>
    <div class="relative space-y-1">
      <span class="text-xs font-mono text-zinc-400 uppercase tracking-wider">Team hours spent checking each month</span>
      <span class={result} data-out="hours">{Math.round(hoursMonth).toLocaleString('en-IN')} hours</span>
      <span class="block text-sm text-zinc-400">Lines per month × minutes per line. The engine checks every line; your team reviews only the exceptions.</span>
    </div>
    <p class="relative text-xs text-zinc-500 leading-relaxed border-t border-zinc-800 pt-4">
      These are your numbers and your assumptions, not a promise of what we will recover. The free claims audit
      measures the real figure on one quarter of your own claims.
    </p>
  </div>
</div>
