---
import '../index.css';
import ConsentScripts from '../components/site/ConsentScripts.astro';
import CookieBanner from '../components/site/CookieBanner.astro';
import {Breadcrumbs} from '../components/site/Breadcrumbs';
import {SiteFooter} from '../components/site/SiteFooter';
import {SiteHeader} from '../components/site/SiteHeader';
import {SHARE_IMAGE} from '../data/site';
import {absoluteUrl, breadcrumbJsonLd, faqJsonLd, jsonLdText, type Crumb, type Faq} from '../lib/seo';

// Every page: head tags, structured data, header and footer.

interface Props {
  title: string;
  description: string;
  /** For analytics: the page template, and on use-case pages its slug. */
  page: {type: string; slug?: string};
  /** The trail after "Home"; the last crumb is this page. */
  crumbs?: Crumb[];
  faqs?: Faq[];
  jsonLd?: object[];
  noindex?: boolean;
}

const {title, description, page, crumbs, faqs, jsonLd = [], noindex = false} = Astro.props;
const path = Astro.url.pathname;
const canonical = absoluteUrl(path);
const shareImage = absoluteUrl(SHARE_IMAGE);
const trail = crumbs && [{name: 'Home', path: '/'}, ...crumbs];
const structuredData = [
  ...(trail ? [breadcrumbJsonLd(trail)] : []),
  ...(faqs?.length ? [faqJsonLd(faqs)] : []),
  ...jsonLd,
];
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='12' fill='%230f766e'/%3E%3Cpath d='M14 16h10l8 28 8-28h10L38 52H26L14 16Z' fill='%23ffffff'/%3E%3C/svg%3E"
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="VipraTech" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    {structuredData.map((data) => <script type="application/ld+json" set:html={jsonLdText(data)} />)}
    <ConsentScripts />
  </head>
  <body class="bg-white text-slate-900 font-sans antialiased selection:bg-teal-100" data-page-type={page.type} data-slug={page.slug}>
    <SiteHeader />
    <main class="overflow-x-hidden">
      {
        trail && (
          <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pt-8">
            <Breadcrumbs crumbs={trail} />
          </div>
        )
      }
      <slot />
    </main>
    <SiteFooter />
    <CookieBanner />
    <script>
      import '../scripts/nav';
      import {trackPage} from '../lib/analytics';
      trackPage();
    </script>
  </body>
</html>
