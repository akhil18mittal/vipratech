---
import App from '../App';
import BaseLayout from '../layouts/BaseLayout.astro';
import {siteLinks} from '../lib/collections';
import {organizationJsonLd} from '../lib/seo';

const links = await siteLinks();
---

<BaseLayout
  title="VipraTech Labs | Evidence-First Applied-AI Engineering"
  description="VipraTech Labs builds evidence-first applied-AI software for business-critical workflows where accuracy, human review, and operational reliability matter."
  page={{type: 'home'}}
  jsonLd={[organizationJsonLd()]}
  homepage
>
  <App client:only="react" solutions={links.solutions} industries={links.industries} />
</BaseLayout>
