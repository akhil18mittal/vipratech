---
import Section from '../components/content/Section.astro';
import {BulletList} from '../components/content/BulletList';
import {CardGrid} from '../components/content/CardGrid';
import {CtaBlock} from '../components/content/CtaBlock';
import {DetailCards} from '../components/content/DetailCards';
import {FaqList} from '../components/content/FaqList';
import {FounderBlock} from '../components/content/FounderBlock';
import {WorkflowSteps} from '../components/content/WorkflowSteps';
import {ContactButtons} from '../components/site/ContactButtons';
import {AUDIT_PATH, contactLinks} from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import {siteContent} from '../lib/collections';
import {STATUS_NOTES, STATUS_ORDER, statusLabel} from '../lib/content';
import {organizationJsonLd} from '../lib/seo';

// The homepage: one product (distributor claims settlement) for one buyer (finance at FMCG and D2C brands), with the
// free claims audit as the next step. The problem and workflow come from the live use case's content file.

const content = await siteContent();
const claims = content.useCase('distributor-scheme-claims');
const contact = contactLinks('/', 'a free claims audit');

const proofPoints = [
  'Running every month at a packaged-food brand since mid-2026',
  'Every line checked against the scheme, the invoice and past claims',
  'Finance approves every credit note. Nothing is paid automatically.',
];

const deliverables = [
  {
    title: 'A credit note sheet ready to approve',
    detail: 'Lines that pass every check, with the recalculated amount beside the claimed amount, in your finance format.',
  },
  {
    title: 'An exception queue with reasons',
    detail: 'Every line that failed a check or is uncertain, with its reason and evidence, so your team decides quickly.',
  },
  {
    title: 'Duplicates and ineligible lines caught',
    detail: 'The same invoice claimed twice, claims under expired schemes and claims for SKUs outside the scheme, across months and distributors.',
  },
  {
    title: 'A leakage report',
    detail: 'What was claimed, what was due and the difference, by distributor, scheme and reason.',
  },
  {
    title: 'A statement for each distributor',
    detail: 'A line-by-line settlement statement distributors can check for themselves, so fewer disputes come back.',
  },
  {
    title: 'An audit trail',
    detail: 'Who approved what and when, with the circular, invoice and proof behind every decision.',
  },
];

const auditSteps = [
  {title: 'Sign an NDA', detail: 'Yours or ours, before you share anything.'},
  {title: "Send last quarter's claims", detail: 'Claim sheets, scheme circulars and the related invoices, in whatever format you have them.'},
  {title: 'Get the report in 5 working days', detail: 'Duplicates, ineligible lines and over-claims, with the amount at risk by distributor, scheme and reason.'},
  {title: 'Walk through it together', detail: 'A 30-minute call with the person who owns claims settlement.'},
];

const pricing = [
  {title: 'Free claims audit', detail: "One recent quarter of your claims, checked line by line. You see what the system finds before you pay anything."},
  {title: 'Paid pilot on live claims', detail: 'About 8 weeks for a fixed fee: two monthly claim cycles for one region or claim type, compared with what finance settled.'},
  {title: 'Monthly subscription', detail: 'Priced by the number of distributors, once the pilot has shown its value.'},
];

const faqs = [
  {
    q: 'What does the free audit need from us?',
    a: "One recent quarter of distributor claim sheets, the scheme circulars for that period and the related invoices or a DMS export. Excel, PDF and scans are all fine. You can start with one region or one claim type.",
  },
  {
    q: 'What happens when the AI is unsure?',
    a: 'Every amount is decided by rules built from your circulars; AI reads the documents and spreadsheets. Any line where a document cannot be read with confidence, a proof is missing or several matches are possible goes to your team with the reason. Nothing uncertain is passed silently.',
  },
  {
    q: 'Do our distributors need to change how they send claims?',
    a: "No. The system reads each distributor's own format. Agreeing a standard template over time reduces exceptions, but it is not needed to start.",
  },
  {
    q: 'Does it replace our DMS or ERP?',
    a: 'No. It reads exports from your DMS and ERP and produces a credit note sheet for finance to post in Tally, SAP or whichever system you use.',
  },
  {
    q: 'Is our data safe with you?',
    a: 'We sign an NDA before you share anything, use your files only for your audit, and delete them after. Your data is not used to train AI models. The security page has the details.',
  },
  {
    q: 'Who will we work with?',
    a: 'Akhilesh Mittal, who built the system that runs at a packaged-food brand today. You work with him directly from the audit to go-live.',
  },
];

const industryCards = content.industries.map((industry) => ({title: industry.name, text: industry.hero.headline, href: industry.url}));
const coverage = STATUS_ORDER.map((status) => ({status, useCases: content.useCases.filter((useCase) => useCase.status === status)}));
---

<BaseLayout
  title="Distributor Claims Reconciliation for FMCG and D2C Brands | VipraTech"
  description="VipraTech checks every distributor claim against your schemes, invoices and past claims, flags duplicates and ineligible lines, and prepares credit notes for finance."
  page={{type: 'home'}}
  faqs={faqs}
  jsonLd={[organizationJsonLd()]}
>
  <section class="pt-14 sm:pt-20 pb-14 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto space-y-6">
    <span class="inline-flex items-center px-3 py-1 rounded-full bg-teal-50 border border-teal-200 text-teal-800 text-xs font-semibold">
      For finance teams at FMCG and D2C brands
    </span>
    <h1 class="text-4xl sm:text-6xl font-bold tracking-tight leading-[1.05] text-slate-900 max-w-4xl">
      Stop paying distributor claims you don't owe.
    </h1>
    <p class="text-lg sm:text-xl text-slate-600 leading-relaxed max-w-3xl">
      VipraTech checks every claim line against your scheme circulars, invoices and past claims, flags duplicates and
      ineligible lines, and gives finance a clean credit note sheet to approve.
    </p>
    <div class="pt-2 space-y-4">
      <ContactButtons links={contact} location="hero" />
      <a href="/sample-audit-report/" class="inline-block text-sm font-semibold text-teal-700 hover:text-teal-900 hover:underline underline-offset-2">
        See a sample audit report →
      </a>
    </div>
    <ul class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-6">
      {
        proofPoints.map((point) => (
          <li class="p-4 bg-slate-50 border border-slate-200 rounded-xl text-sm text-slate-700 leading-relaxed">{point}</li>
        ))
      }
    </ul>
  </section>

  <Section title="Claims settlement is a monthly leak" intro={claims.problem.intro}>
    <DetailCards items={claims.problem.pain_points} />
  </Section>

  <Section id="how-it-works" title="How it works" intro={claims.solution.overview}>
    <WorkflowSteps steps={claims.workflow} />
    <p class="text-base">
      <a href={claims.url} class="font-semibold text-teal-700 hover:text-teal-900 hover:underline underline-offset-2">
        Full details: diagrams, inputs, integrations, guardrails and pilot plan →
      </a>
    </p>
  </Section>

  <Section title="What finance gets every month">
    <DetailCards items={deliverables} />
  </Section>

  <Section id="free-audit" title="Start with a free claims audit" intro="See what the system finds on your own claims before you commit to anything.">
    <WorkflowSteps steps={auditSteps} />
    <div class="flex flex-wrap items-center gap-4 pt-2">
      <a
        href={AUDIT_PATH}
        data-cta="audit"
        data-cta-location="audit-section"
        class="px-6 py-3.5 bg-teal-700 hover:bg-teal-800 text-white font-semibold rounded-xl text-sm transition-colors"
      >
        Get a free claims audit
      </a>
      <a href="/sample-audit-report/" class="text-sm font-semibold text-teal-700 hover:text-teal-900 hover:underline underline-offset-2">
        See a sample report →
      </a>
    </div>
  </Section>

  <Section title="Your data stays under your control">
    <BulletList
      items={[
        'NDA signed before you share any file',
        'Files used only for your audit, and deleted afterwards',
        'Your data is not used to train AI models',
        'For live use, the system can run in your own cloud account',
      ]}
    />
    <p class="text-base">
      <a href="/security/" class="font-semibold text-teal-700 hover:text-teal-900 hover:underline underline-offset-2">How we handle your data →</a>
    </p>
  </Section>

  <Section title="How pricing works">
    <WorkflowSteps steps={pricing} />
  </Section>

  <Section id="coverage" title="Every claim and deduction we check" intro="Distributor claims settlement is live today. The rest run on the same engine, or are being built with design partners.">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {
        coverage.map((group) => (
          <div class="p-6 bg-white border border-slate-200 rounded-2xl shadow-sm">
            <h3 class="text-lg font-bold text-slate-900">{statusLabel(group.status)}</h3>
            <p class="mt-1 text-sm text-slate-500 leading-relaxed">{STATUS_NOTES[group.status]}</p>
            <ul class="mt-4 space-y-2">
              {group.useCases.map((useCase) => (
                <li>
                  <a href={useCase.url} class="text-sm font-medium text-teal-700 hover:text-teal-900 hover:underline underline-offset-2">
                    {useCase.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </Section>

  <Section id="industries" title="By industry" intro="How these checks work for brands that sell through distributors, dealers, retail chains and marketplaces.">
    <CardGrid items={industryCards} columns={2} />
  </Section>

  <FounderBlock />

  <Section title="Questions finance teams ask">
    <FaqList faqs={faqs} />
  </Section>

  <CtaBlock
    headline="Send last quarter's claims. Get the audit in 5 working days."
    text="Free, under NDA, with a walkthrough of every finding."
    contact={contact}
  />
</BaseLayout>
