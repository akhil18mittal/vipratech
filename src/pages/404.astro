---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found | VipraTech" description="Page not found." page={{type: '404'}} noindex>
  <section class="py-24 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto">
    <span class="text-xs font-mono text-lime-400 uppercase tracking-widest font-bold">404</span>
    <h1 class="text-4xl sm:text-6xl font-black tracking-tight leading-[1.08] text-white mt-2">Page not found</h1>
    <div class="flex flex-wrap gap-4 mt-10">
      <a
        href="/"
        class="px-6 py-4 bg-zinc-900 hover:bg-zinc-800 text-zinc-200 border border-zinc-800 rounded-xl text-sm font-semibold transition-all font-mono"
        >Home</a
      >
      <a
        href="/use-cases/"
        class="px-6 py-4 bg-zinc-900 hover:bg-zinc-800 text-zinc-200 border border-zinc-800 rounded-xl text-sm font-semibold transition-all font-mono"
        >Use case library</a
      >
    </div>
  </section>
</BaseLayout>
