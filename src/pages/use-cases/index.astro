---
import Section from '../../components/content/Section.astro';
import {CardGrid} from '../../components/content/CardGrid';
import {CtaBlock} from '../../components/content/CtaBlock';
import {FounderBlock} from '../../components/content/FounderBlock';
import {PageHero} from '../../components/content/PageHero';
import {contactLinks} from '../../data/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {siteContent} from '../../lib/collections';
import {STATUS_NOTES, STATUS_ORDER, statusLabel} from '../../lib/content';

// Every use case, grouped by how ready it is: live, pilot-ready on the same engine, or early access.

const {useCases} = await siteContent();
const description =
  'Every claim, deduction and reconciliation VipraTech checks for finance teams at consumer brands: what is live today, what is ready to pilot, and what we are building with design partners.';
const contact = contactLinks('/use-cases/', 'VipraTech claims reconciliation');
const groups = STATUS_ORDER.map((status) => ({
  status,
  cards: useCases
    .filter((useCase) => useCase.status === status)
    .map((useCase) => ({label: statusLabel(useCase.status), title: useCase.title, text: useCase.summary, href: useCase.url})),
})).filter((group) => group.cards.length > 0);
---

<BaseLayout
  title="Claims and Deductions Reconciliation Use Cases | VipraTech"
  description="Distributor claims, returns, rate differences, dealer incentives, modern-trade, quick-commerce and marketplace deductions, and ledger reconciliation."
  page={{type: 'library'}}
  crumbs={[{name: 'Use cases', path: '/use-cases/'}]}
>
  <PageHero title="Use cases" subtitle={description} contact={contact} />

  {
    groups.map((group) => (
      <Section title={statusLabel(group.status)} intro={STATUS_NOTES[group.status]}>
        <CardGrid items={group.cards} />
      </Section>
    ))
  }

  <FounderBlock />

  <CtaBlock headline="Start with a free claims audit" contact={contact} />
</BaseLayout>
