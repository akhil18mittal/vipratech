---
import Section from '../../components/content/Section.astro';
import {CardGrid} from '../../components/content/CardGrid';
import {CtaBlock} from '../../components/content/CtaBlock';
import {FounderBlock} from '../../components/content/FounderBlock';
import {PageHero} from '../../components/content/PageHero';
import {contactLinks} from '../../data/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {siteContent} from '../../lib/collections';
import {CATEGORIES, CATEGORY_ORDER} from '../../data/categories';
import {isInProduction} from '../../lib/content';

// Every use case, grouped by category.

const {useCases} = await siteContent();
const description =
  'Every claim, deduction, subsidy and settlement VipraTech reconciles for finance teams, each with its workflow, app screens, architecture, decision rules and exception codes.';
const contact = contactLinks('/use-cases/', 'VipraTech claims reconciliation');
const groups = CATEGORY_ORDER.map((category) => ({
  ...CATEGORIES[category],
  id: category,
  cards: useCases
    .filter((useCase) => useCase.category === category)
    .map((useCase) => ({
      label: isInProduction(useCase) ? 'In production' : undefined,
      title: useCase.title,
      text: useCase.summary,
      href: useCase.url,
      featured: isInProduction(useCase),
    })),
})).filter((group) => group.cards.length > 0);
---

<BaseLayout
  title="Claims and Deductions Reconciliation Use Cases | VipraTech"
  description="Distributor and dealer claims, quick-commerce and modern-trade deductions, credit notes, ledgers, fertiliser subsidy, freight and quality claims."
  page={{type: 'library'}}
  crumbs={[{name: 'Use cases', path: '/use-cases/'}]}
>
  <PageHero title="Use cases" subtitle={description} contact={contact} />

  {
    groups.map((group) => (
      <Section id={group.id} title={group.label} intro={group.intro}>
        <CardGrid items={group.cards} />
      </Section>
    ))
  }

  <FounderBlock />

  <CtaBlock headline="Start with a free claims audit" contact={contact} />
</BaseLayout>
